config_version=5

[application]
config/name="Pixelbolt cutout walks"
run/main_scene="res://walk.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=240
window/size/viewport_height=144
window/size/window_width_override=960
window/size/window_height_override=576
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.89, 0.88, 0.85, 1)
